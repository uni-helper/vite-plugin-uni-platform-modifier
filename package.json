{
  "name": "@uni-helper/vite-plugin-uni-platform-modifier",
  "type": "module",
  "version": "0.1.1",
  "packageManager": "pnpm@12.14.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26",
      "onFail": "warn"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "warn"
    }
  },
  "description": "",
  "author": {
    "name": "kejunmao",
    "email": "kejun1997@gmail.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/uni-helper/vite-plugin-uni-platform-modifier#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uni-helper/vite-plugin-uni-platform-modifier.git"
  },
  "bugs": "https://github.com/uni-helper/vite-plugin-uni-platform-modifier/issues",
  "keywords": [],
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*",
        "./dist/index.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "build:play:h5": "pnpm -C playground run build:h5",
    "dev:play:h5": "pnpm -C playground run dev:h5",
    "build:play:mp-weixin": "pnpm -C playground run build:mp-weixin",
    "dev:play:mp-weixin": "pnpm -C playground run dev:mp-weixin",
    "dev": "tsdown --watch",
    "prepublishOnly": "pnpm build",
    "release": "bumpp",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "vite": "^5.0.0"
  },
  "dependencies": {
    "@uni-helper/uni-env": "catalog:",
    "@vue/compiler-core": "catalog:",
    "@vue/compiler-dom": "catalog:",
    "magic-string": "catalog:"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "bumpp": "catalog:",
    "eslint": "catalog:",
    "fast-glob": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
